{
  "expo": {
    "name": "Lode",
    "slug": "lode",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "lode",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.lideeyah.lode",
      "adaptiveIcon": {
        "backgroundColor": "#1C1A17",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-dev-client",
      "react-native-quick-crypto",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F2EEE4",
          "imageWidth": 300
        }
      ],
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ]
    ],
    "extra": {
      "solanaCluster": "devnet",
      "solanaRpcEndpoint": "https://api.devnet.solana.com",
      "eas": {
        "projectId": "19c37c8c-1446-4575-ba8c-98082958ef67"
      }
    },
    "owner": "lideeyah",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/19c37c8c-1446-4575-ba8c-98082958ef67"
    },
    "ios": {}
  }
}
